# ── Servidor ────────────────────────────────────────────────────────────────
# La API escucha solo en loopback; Next.js (servidor) es quien la consume.
HOST=127.0.0.1
PORT=4000
# Orígenes permitidos por CORS, separados por comas. OBLIGATORIO en producción.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Base de datos (MySQL) ───────────────────────────────────────────────────
# Opción 1: URL completa (recomendada). Usa un usuario de permisos mínimos, NO root:
#   ver prisma/manual-migrations/create-app-db-user.sql
#   DATABASE_URL=mysql://horus_app:<contraseña url-encoded>@localhost:3306/horus
DATABASE_URL=
# Opción 2: variables sueltas (se usan solo si DATABASE_URL está vacío).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=horus
DB_USER=
DB_PASSWORD=
# DB_SSL=true

# ── Autenticación ───────────────────────────────────────────────────────────
# Secreto para firmar los JWT (mínimo 32 bytes). Genera uno distinto por entorno:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Duración del token en segundos (mínimo 60).
JWT_TTL=900
# JWT_ISSUER=http://localhost:4000

# Registro público de cuentas. Déjalo en false: las cuentas las crea un administrador.
ALLOW_PUBLIC_REGISTRATION=false
# Exige correo verificado para iniciar sesión (las cuentas creadas por un admin ya lo están).
REQUIRE_VERIFIED_EMAIL=false

# ── Asistente (Google Gemini) ───────────────────────────────────────────────
# Solo backend; nunca usar NEXT_PUBLIC_ ni incluir la clave en el frontend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Consultas por minuto y usuario que acepta la API. Vacío o 0 = sin límite propio
# (solo aplican las cuotas de tu proyecto en Google). Pon un valor si quieres
# proteger la cuota o el gasto frente a una cuenta comprometida.
# ASISTENTE_MAX_CONSULTAS_POR_MINUTO=
