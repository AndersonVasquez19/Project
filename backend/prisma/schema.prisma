generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id                                                                  BigInt                    @id @default(autoincrement())
  name                                                                String                    @db.VarChar(255)
  email                                                               String                    @unique(map: "users_email_unique") @db.VarChar(255)
  emailVerifiedAt                                                     DateTime?                 @map("email_verified_at") @db.Timestamp(0)
  password                                                            String                    @db.VarChar(255)
  rememberToken                                                       String?                   @map("remember_token") @db.VarChar(100)
  createdAt                                                           DateTime?                 @map("created_at") @db.Timestamp(0)
  updatedAt                                                           DateTime?                 @map("updated_at") @db.Timestamp(0)
  jwtVersion                                                          Int                       @default(0) @map("jwt_version")
  aprobaciones_internas_aprobaciones_internas_aprobador_idTousers     aprobaciones_internas[]   @relation("aprobaciones_internas_aprobador_idTousers")
  aprobaciones_internas_aprobaciones_internas_solicitante_idTousers   aprobaciones_internas[]   @relation("aprobaciones_internas_solicitante_idTousers")
  audit_logs                                                          audit_logs[]
  cotizacion_historial                                                cotizacion_historial[]
  curso_publicaciones                                                 curso_publicaciones[]
  notificaciones_internas                                             notificaciones_internas[]
  procesos_internos_procesos_internos_created_byTousers               procesos_internos[]       @relation("procesos_internos_created_byTousers")
  procesos_internos_procesos_internos_responsable_idTousers           procesos_internos[]       @relation("procesos_internos_responsable_idTousers")
  reclamacion_historial                                               reclamacion_historial[]
  reclamaciones                                                       reclamaciones[]
  servicio_publicaciones                                              servicio_publicaciones[]
  solicitudes_cotizacion_solicitudes_cotizacion_creado_porTousers     solicitudes_cotizacion[]  @relation("solicitudes_cotizacion_creado_porTousers")
  solicitudes_cotizacion_solicitudes_cotizacion_responsable_idTousers solicitudes_cotizacion[]  @relation("solicitudes_cotizacion_responsable_idTousers")

  @@map("users")
}

model aprobaciones_internas {
  id                                                BigInt    @id @default(autoincrement())
  titulo                                            String    @db.VarChar(255)
  tipo                                              String    @default("solicitud") @db.VarChar(255)
  descripcion                                       String?
  estado                                            String    @default("pendiente") @db.VarChar(255)
  solicitante_id                                    BigInt?
  aprobador_id                                      BigInt?
  comentario                                        String?
  referencia                                        String?   @db.VarChar(255)
  created_at                                        DateTime? @db.Timestamp(0)
  updated_at                                        DateTime? @db.Timestamp(0)
  users_aprobaciones_internas_aprobador_idTousers   User?     @relation("aprobaciones_internas_aprobador_idTousers", fields: [aprobador_id], references: [id], onUpdate: NoAction, map: "aprobaciones_internas_aprobador_id_foreign")
  users_aprobaciones_internas_solicitante_idTousers User?     @relation("aprobaciones_internas_solicitante_idTousers", fields: [solicitante_id], references: [id], onUpdate: NoAction, map: "aprobaciones_internas_solicitante_id_foreign")
}

model audit_logs {
  id         BigInt   @id @default(autoincrement())
  user_id    BigInt?
  action     String   @db.VarChar(255)
  model_type String?  @db.VarChar(255)
  model_id   BigInt?
  changes    Json?    @db.Json
  ip_address String?  @db.VarChar(255)
  created_at DateTime @default(now()) @db.Timestamp(0)
  users      User?    @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "audit_logs_user_id_foreign")
}

model cache {
  key        String @id @db.VarChar(255)
  value      String
  expiration Int

  @@index([expiration], map: "cache_expiration_index")
}

model cache_locks {
  key        String @id @db.VarChar(255)
  owner      String @db.VarChar(255)
  expiration Int

  @@index([expiration], map: "cache_locks_expiration_index")
}

model chat_intents {
  id         BigInt    @id @default(autoincrement())
  nombre     String    @unique(map: "chat_intents_nombre_unique") @db.VarChar(50)
  keywords   Json      @db.Json
  respuesta  String
  prioridad  Int       @default(10)
  activo     Boolean   @default(true)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model chat_logs {
  id               BigInt    @id @default(autoincrement())
  session_id       String    @db.VarChar(64)
  mensaje_usuario  String
  respuesta_bot    String
  intent_detectado String?   @db.VarChar(50)
  created_at       DateTime? @db.Timestamp(0)
  updated_at       DateTime? @db.Timestamp(0)
  fuente           String?   @db.VarChar(16)

  @@index([session_id], map: "chat_logs_session_id_index")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cotizacion_historial {
  id                     BigInt                 @id @default(autoincrement())
  solicitud_id           BigInt
  revision               Int
  evento                 String                 @db.VarChar(255)
  actor_id               BigInt?
  metadatos              Json                   @db.Json
  nota                   String?
  actor_ambito           BigInt
  clave_hash             String?                @db.VarChar(64)
  huella                 String?                @db.VarChar(64)
  created_at             DateTime               @db.DateTime(0)
  users                  User?                  @relation(fields: [actor_id], references: [id], onUpdate: NoAction, map: "cotizacion_historial_actor_id_foreign")
  solicitudes_cotizacion solicitudes_cotizacion @relation(fields: [solicitud_id], references: [id], onUpdate: NoAction, map: "cotizacion_historial_solicitud_id_foreign")

  @@unique([solicitud_id, revision], map: "cotizacion_historial_revision_unica")
  @@unique([solicitud_id, actor_ambito, clave_hash], map: "cotizacion_seguimiento_unico")
  @@index([actor_id], map: "cotizacion_historial_actor_id_index")
}

model curso_publicaciones {
  id             BigInt    @id @default(autoincrement())
  curso_id       BigInt    @unique(map: "curso_publicaciones_curso_id_unique")
  titulo         String    @db.VarChar(120)
  resumen        String    @db.VarChar(500)
  modalidad      String    @db.VarChar(30)
